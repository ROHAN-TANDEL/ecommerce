<div class="relative bg-white hero bg-base-200 min-h-screen overflow-hidden
            before:absolute before:inset-0
            before:bg-[url(/logo_8.png)] before:bg-cover before:bg-center
            before:filter before:blur-[10px] before:scale-105">

  <!-- Add 'relative z-10' to this container so the form safely sits ON TOP of the blurred background -->
  <div class="relative z-10 h-64 w-full bg-white hero-content flex-col lg:flex-row-reverse bg-cover bg-center">
    <div class="text-center lg:text-left">
      <h1 class="text-5xl font-bold">Build Connect Grow</h1>
      <p class="py-6">
        A flexible Saas development platform for real-world possibilities.
      </p>
    </div>
    <div class="bg-white card bg-base-100 w-full max-w-sm shrink-0 shadow-2xl">
      <div class="card-body mx-auto">
        <div><img src="logo_1.png"/></div>
        <div class="mx-auto">
          <fieldset class="fieldset">
            <label class="label">username</label>
            <input type="email" class="input bg-white" placeholder="username/email" />
            <label class="label">password</label>
            <input type="password" class="input bg-white" placeholder="password" />
            <div class="flex justify-center">
              <button class="app-color-white btn btn-neutral mt-4 app-bg-color-primary white">Login</button>
            </div>
          </fieldset>
        </div>
      </div>
    </div>
  </div>
</div>
