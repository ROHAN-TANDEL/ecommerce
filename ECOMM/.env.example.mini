# ============================================================
# IDENTITY ACCESS MANAGEMENT DOMAIN
# ============================================================

# Strategy: multi_db_multi_schema | multi_db_single_schema | single_db_multi_schema | single_db_single_schema | read_write_separated
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_STRATEGY=multi_db_multi_schema

# Master Database
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_MASTER_HOST=localhost
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_MASTER_PORT=5432
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_MASTER_USERNAME=root
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_MASTER_PASSWORD=password
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_MASTER_DATABASE=identity_access_management_master
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_MASTER_SSL=false

# Client Database
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_CLIENT_HOST=localhost
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_CLIENT_PORT=5432
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_CLIENT_USERNAME=root
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_CLIENT_PASSWORD=password
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_CLIENT_DATABASE=identity_access_management_client
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_DB_CLIENT_SSL=false

# Master Schemas
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_MASTER_NAMES=public,auth,tenant_
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_MASTER_1_DEFAULT=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_MASTER_1_SHARED=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_MASTER_1_TABLES=users,roles,permissions,tenants
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_MASTER_2_SHARED=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_MASTER_2_TABLES=sessions,refresh_tokens,password_resets
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_MASTER_3_TENANT_SPECIFIC=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_MASTER_3_TABLES=user_profiles,settings,audit_logs

# Client Schemas
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_CLIENT_NAMES=shared_client,client_
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_CLIENT_1_SHARED=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_CLIENT_1_TABLES=clients,client_settings,client_configs
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_CLIENT_2_TENANT_SPECIFIC=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_CLIENT_2_TABLES=client_data,client_audit

# Default Schema
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_SCHEMA_DEFAULT=public

# Tenant Configuration
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_TENANT_ENABLED=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_TENANT_HEADER=x-tenant-id


# ============================================================
# SUBSCRIPTION MANAGEMENT DOMAIN
# ============================================================

DOMAIN_SUBSCRIPTION_MANAGEMENT_STRATEGY=multi_db_single_schema

DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_MASTER_HOST=localhost
DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_MASTER_PORT=5432
DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_MASTER_USERNAME=root
DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_MASTER_PASSWORD=password
DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_MASTER_DATABASE=subscription_management_master

DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_CLIENT_HOST=localhost
DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_CLIENT_PORT=5432
DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_CLIENT_USERNAME=root
DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_CLIENT_PASSWORD=password
DOMAIN_SUBSCRIPTION_MANAGEMENT_DB_CLIENT_DATABASE=subscription_management_client

DOMAIN_SUBSCRIPTION_MANAGEMENT_SCHEMA_MASTER_NAMES=public
DOMAIN_SUBSCRIPTION_MANAGEMENT_SCHEMA_MASTER_1_DEFAULT=true
DOMAIN_SUBSCRIPTION_MANAGEMENT_SCHEMA_MASTER_1_SHARED=true
DOMAIN_SUBSCRIPTION_MANAGEMENT_SCHEMA_MASTER_1_TABLES=subscriptions,plans,pricing

DOMAIN_SUBSCRIPTION_MANAGEMENT_SCHEMA_CLIENT_NAMES=shared_client
DOMAIN_SUBSCRIPTION_MANAGEMENT_SCHEMA_CLIENT_1_SHARED=true
DOMAIN_SUBSCRIPTION_MANAGEMENT_SCHEMA_CLIENT_1_TABLES=client_subscriptions,client_usage

DOMAIN_SUBSCRIPTION_MANAGEMENT_SCHEMA_DEFAULT=public
DOMAIN_SUBSCRIPTION_MANAGEMENT_TENANT_ENABLED=true
DOMAIN_SUBSCRIPTION_MANAGEMENT_TENANT_HEADER=x-tenant-id


# ============================================================
# PRODUCT MANAGEMENT DOMAIN - Single DB, Multi-Schema
# ============================================================

DOMAIN_PRODUCT_MANAGEMENT_STRATEGY=single_db_multi_schema

DOMAIN_PRODUCT_MANAGEMENT_DB_HOST=localhost
DOMAIN_PRODUCT_MANAGEMENT_DB_PORT=5432
DOMAIN_PRODUCT_MANAGEMENT_DB_USERNAME=root
DOMAIN_PRODUCT_MANAGEMENT_DB_PASSWORD=password
DOMAIN_PRODUCT_MANAGEMENT_DB_DATABASE=product_management

DOMAIN_PRODUCT_MANAGEMENT_SCHEMA_MASTER_NAMES=public,tenant_
DOMAIN_PRODUCT_MANAGEMENT_SCHEMA_MASTER_1_DEFAULT=true
DOMAIN_PRODUCT_MANAGEMENT_SCHEMA_MASTER_1_SHARED=true
DOMAIN_PRODUCT_MANAGEMENT_SCHEMA_MASTER_1_TABLES=products,categories,inventory
DOMAIN_PRODUCT_MANAGEMENT_SCHEMA_MASTER_2_TENANT_SPECIFIC=true
DOMAIN_PRODUCT_MANAGEMENT_SCHEMA_MASTER_2_TABLES=tenant_products,tenant_pricing

DOMAIN_PRODUCT_MANAGEMENT_SCHEMA_DEFAULT=public
DOMAIN_PRODUCT_MANAGEMENT_TENANT_ENABLED=true
DOMAIN_PRODUCT_MANAGEMENT_TENANT_HEADER=x-tenant-id


# ============================================================
# AUDIT MANAGEMENT - Simple, No Tenant
# ============================================================

DOMAIN_AUDIT_MANAGEMENT_STRATEGY=single_db_single_schema

DOMAIN_AUDIT_MANAGEMENT_DB_HOST=localhost
DOMAIN_AUDIT_MANAGEMENT_DB_PORT=5432
DOMAIN_AUDIT_MANAGEMENT_DB_USERNAME=root
DOMAIN_AUDIT_MANAGEMENT_DB_PASSWORD=password
DOMAIN_AUDIT_MANAGEMENT_DB_DATABASE=audit_management

DOMAIN_AUDIT_MANAGEMENT_SCHEMA_MASTER_NAMES=public
DOMAIN_AUDIT_MANAGEMENT_SCHEMA_MASTER_1_DEFAULT=true
DOMAIN_AUDIT_MANAGEMENT_SCHEMA_MASTER_1_SHARED=true
DOMAIN_AUDIT_MANAGEMENT_SCHEMA_MASTER_1_TABLES=audit_logs,activity_logs

DOMAIN_AUDIT_MANAGEMENT_SCHEMA_DEFAULT=public
DOMAIN_AUDIT_MANAGEMENT_TENANT_ENABLED=false


# ============================================================
# ORDER MANAGEMENT - Read/Write Separated
# ============================================================

DOMAIN_ORDER_MANAGEMENT_STRATEGY=read_write_separated

# Read Replica
DOMAIN_ORDER_MANAGEMENT_DB_READ_HOST=localhost
DOMAIN_ORDER_MANAGEMENT_DB_READ_PORT=5433
DOMAIN_ORDER_MANAGEMENT_DB_READ_USERNAME=readonly
DOMAIN_ORDER_MANAGEMENT_DB_READ_PASSWORD=readonly
DOMAIN_ORDER_MANAGEMENT_DB_READ_DATABASE=order_management_read

# Write Master
DOMAIN_ORDER_MANAGEMENT_DB_WRITE_HOST=localhost
DOMAIN_ORDER_MANAGEMENT_DB_WRITE_PORT=5432
DOMAIN_ORDER_MANAGEMENT_DB_WRITE_USERNAME=root
DOMAIN_ORDER_MANAGEMENT_DB_WRITE_PASSWORD=password
DOMAIN_ORDER_MANAGEMENT_DB_WRITE_DATABASE=order_management_write

DOMAIN_ORDER_MANAGEMENT_SCHEMA_MASTER_NAMES=public,tenant_
DOMAIN_ORDER_MANAGEMENT_SCHEMA_MASTER_1_DEFAULT=true
DOMAIN_ORDER_MANAGEMENT_SCHEMA_MASTER_1_SHARED=true
DOMAIN_ORDER_MANAGEMENT_SCHEMA_MASTER_1_TABLES=orders,order_items,shipments
DOMAIN_ORDER_MANAGEMENT_SCHEMA_MASTER_2_TENANT_SPECIFIC=true
DOMAIN_ORDER_MANAGEMENT_SCHEMA_MASTER_2_TABLES=tenant_orders,tenant_order_items

DOMAIN_ORDER_MANAGEMENT_SCHEMA_DEFAULT=public
DOMAIN_ORDER_MANAGEMENT_TENANT_ENABLED=true
DOMAIN_ORDER_MANAGEMENT_TENANT_HEADER=x-tenant-id