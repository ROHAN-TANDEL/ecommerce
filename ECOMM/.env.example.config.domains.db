# Identity Access Management Master
DB_IAM_MASTER_HOST=localhost
DB_IAM_MASTER_PORT=5432
DB_IAM_MASTER_USERNAME=root
DB_IAM_MASTER_PASSWORD=root123
DB_IAM_MASTER_DATABASE=identity_access_management_master

# Identity Access Management Client
DB_IAM_CLIENT_HOST=localhost
DB_IAM_CLIENT_PORT=5432
DB_IAM_CLIENT_USERNAME=root
DB_IAM_CLIENT_PASSWORD=root123
DB_IAM_CLIENT_DATABASE=identity_access_management_client

# Authorization Management Master
DB_AUTHZ_MASTER_HOST=localhost
DB_AUTHZ_MASTER_PORT=5432
DB_AUTHZ_MASTER_USERNAME=root
DB_AUTHZ_MASTER_PASSWORD=root123
DB_AUTHZ_MASTER_DATABASE=authorization_management_master

# Authorization Management Client
DB_AUTHZ_CLIENT_HOST=localhost
DB_AUTHZ_CLIENT_PORT=5432
DB_AUTHZ_CLIENT_USERNAME=root
DB_AUTHZ_CLIENT_PASSWORD=root123
DB_AUTHZ_CLIENT_DATABASE=authorization_management_client

# ============================================================
# DOMAIN TO DATABASE MAPPINGS
# ============================================================

# identity_access_management → Uses combined DB (both domains in one DB)
MAPPING_IDENTITY_ACCESS_MANAGEMENT_MASTER=identity_authorization
MAPPING_IDENTITY_ACCESS_MANAGEMENT_CLIENT=iam_client

# authorization_management → Uses combined DB (both domains in one DB)
MAPPING_AUTHORIZATION_MANAGEMENT_MASTER=identity_authorization
MAPPING_AUTHORIZATION_MANAGEMENT_CLIENT=authz_client

# OR - Each domain uses separate DBs
# MAPPING_IDENTITY_ACCESS_MANAGEMENT_MASTER=iam_master
# MAPPING_AUTHORIZATION_MANAGEMENT_MASTER=authz_master

# ============================================================
# STRATEGIES (optional, uses defaults)
# ============================================================

STRATEGY_IDENTITY_ACCESS_MANAGEMENT=multi_db_multi_schema
STRATEGY_AUTHORIZATION_MANAGEMENT=multi_db_multi_schema

# ============================================================
# TENANT CONFIGURATION
# ============================================================

TENANT_IDENTITY_ACCESS_MANAGEMENT_ENABLED=true
TENANT_AUTHORIZATION_MANAGEMENT_ENABLED=true