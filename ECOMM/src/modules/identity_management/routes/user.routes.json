	"components": {
		"parameters": {
			"UserId": {
				"name": "id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "integer"
				},
				"example": 3
			},
			"ViewId": {
				"name": "id",
				"in": "path",
				"required": true,
				"schema": {
					"type": "integer"
				},
				"example": 1
			}
		},

		"schemas": {
			"CreateUserRequest": {
				"type": "object",
				"required": [
					"first_name",
					"last_name",
					"email",
					"status"
				],
				"properties": {
					"first_name": {
						"type": "string",
						"example": "John"
					},
					"last_name": {
						"type": "string",
						"example": "Doe"
					},
					"email": {
						"type": "string",
						"format": "email",
						"example": "John@doe.com"
					},
					"status": {
						"type": "string",
						"example": "active"
					}
				}
			},

			"User": {
				"type": "object",
				"properties": {
					"id": {
						"type": "integer",
						"example": 1
					},
					"first_name": {
						"type": "string",
						"example": "John 1"
					},
					"last_name": {
						"type": "string",
						"example": "Doe 1"
					},
					"email": {
						"type": "string",
						"format": "email",
						"example": "John1@doe.com"
					},
					"status": {
						"type": "string",
						"example": "active"
					}
				}
			},

			"UserFilterRequest": {
				"type": "object",
				"properties": {
					"filters": {
						"$ref": "#/components/schemas/UserFilters"
					}
				}
			},

			"UserFilters": {
				"type": "object",
				"properties": {
					"first_name": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"example": ["one", "jon"]
					},
					"last_name": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"example": ["doe", "jon"]
					},
					"status": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"example": ["active"]
					},
					"date": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"example": ["10-12-2022", "20-12-2022"]
					}
				}
			},

			"UserListRequest": {
				"type": "object",
				"properties": {
					"filters": {
						"$ref": "#/components/schemas/UserFilters"
					},
					"sort": {
						"type": "object",
						"additionalProperties": {
							"type": "string",
							"enum": ["asc", "desc"]
						},
						"example": {
							"first_name": "asc"
						}
					}
				}
			},

			"UserListResponse": {
				"type": "object",
				"properties": {
					"data": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/User"
						}
					},
					"status": {
						"type": "string",
						"example": "success"
					},
					"message": {
						"type": "string",
						"example": "users list"
					},
					"pagination": {
						"$ref": "#/components/schemas/Pagination"
					}
				}
			},

			"Pagination": {
				"type": "object",
				"properties": {
					"page": {
						"type": "integer",
						"example": 10
					},
					"limit": {
						"type": "integer",
						"example": 12
					},
					"total": {
						"type": "integer",
						"example": 1200
					},
					"totalPages": {
						"type": "integer",
						"example": 12
					}
				}
			},

			"UserDetailsResponse": {
				"type": "object",
				"properties": {
					"data": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/User"
						}
					},
					"message": {
						"type": "string",
						"example": "user details"
					},
					"status": {
						"type": "string",
						"example": "success"
					}
				}
			},

			"BulkUpdateUserRequest": {
				"type": "object",
				"properties": {
					"filters": {
						"$ref": "#/components/schemas/UserFilters"
					},
					"data": {
						"type": "object",
						"additionalProperties": true,
						"example": {
							"first_name": "Munira",
							"product": "Guru"
						}
					}
				},
				"required": [
					"filters",
					"data"
				]
			},

			"DeleteUsersRequest": {
				"type": "object",
				"required": [
					"id"
				],
				"properties": {
					"id": {
						"type": "array",
						"items": {
							"type": "integer"
						},
						"example": [1, 2, 3, 4, 6]
					}
				}
			},

			"SuccessResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string",
						"example": "operation completed successfully"
					},
					"status": {
						"type": "string",
						"enum": ["success"],
						"example": "success"
					}
				}
			},

			"FailureResponse": {
				"type": "object",
				"properties": {
					"message": {
						"type": "string",
						"example": "operation failed"
					},
					"status": {
						"type": "string",
						"enum": ["failure"],
						"example": "failure"
					}
				}
			}
		}
	}
}