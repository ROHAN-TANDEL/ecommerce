			}
		},

		"/users": {
			"get": {
				"tags": ["Users"],
				"summary": "Get users",
				"operationId": "getUsers",
				"requestBody": {
					"required": false,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/UserListRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Users list",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserListResponse"
								},
								"example": {
									"data": [
										{
											"id": 1,
											"first_name": "John 1",
											"last_name": "Doe 1",
											"email": "John1@doe.com",
											"status": "active"
										},
										{
											"id": 2,
											"first_name": "John 2",
											"last_name": "Doe 2",
											"email": "John2@doe.com",
											"status": "pending"
										}
									],
									"status": "success",
									"message": "users list",
									"pagination": {
										"page": 10,
										"limit": 12,
										"total": 1200,
										"totalPages": 12
									}
								}
							}
						}
					}
				}
			}
		},

		"/users/{id}": {
			"get": {
				"tags": ["Users"],
				"summary": "Get user",
				"operationId": "getUser",
				"parameters": [
