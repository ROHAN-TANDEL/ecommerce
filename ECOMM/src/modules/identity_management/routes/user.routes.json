	"paths": {
		"/users/create": {
			"post": {
				"tags": ["Users"],
				"summary": "Create user",
				"operationId": "createUser",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreateUserRequest"
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "User created successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SuccessResponse"
								},
								"example": {
									"message": "user created successfully",
									"status": "success"
								}
							}
						}
					},
					"400": {
						"description": "User creation failed",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/FailureResponse"
								},
								"example": {
									"message": "user did not create",
									"status": "failure"
								}
							}
						}
					}
				}
			}
		},

		"/users/create/all": {
			"post": {
				"tags": ["Users"],
				"summary": "Create all users",
				"operationId": "createAllUsers",
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/CreateUserRequest"
								}
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "All users created successfully",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SuccessResponse"
								},
								"example": {
									"message": "all users created successfully",
									"status": "success"
								}
							}
						}
					},
					"400": {
						"description": "All users failed to create",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/FailureResponse"
								},
								"example": {
									"message": "all users failed to create",
									"status": "failure"
								}
							}
						}
					}
				}
			}
		},

