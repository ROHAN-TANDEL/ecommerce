					}
				],
				"responses": {
					"200": {
						"description": "User details",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/UserDetailsResponse"
								},
								"example": {
									"data": [
										{
											"id": 1,
											"first_name": "John 1",
											"last_name": "Doe 1",
											"email": "John1@doe.com",
											"status": "active"
										}
									],
									"message": "user details",
									"status": "success"
								}
							}
						}
					}
				}
			}
		},

