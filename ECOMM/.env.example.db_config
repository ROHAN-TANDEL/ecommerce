DB_IAM_MASTER_PASSWORD=root123
DB_IAM_MASTER_DATABASE=identity_access_management_master

# Identity Access Management Client
DB_IAM_CLIENT_HOST=localhost
DB_IAM_CLIENT_PORT=5432
DB_IAM_CLIENT_USERNAME=root
DB_IAM_CLIENT_PASSWORD=root123
DB_IAM_CLIENT_DATABASE=identity_access_management_client

# Authorization Management Master
DB_AUTHZ_MASTER_HOST=localhost
DB_AUTHZ_MASTER_PORT=5432
DB_AUTHZ_MASTER_USERNAME=root
DB_AUTHZ_MASTER_PASSWORD=root123
DB_AUTHZ_MASTER_DATABASE=authorization_management_master

# Authorization Management Client
DB_AUTHZ_CLIENT_HOST=localhost
DB_AUTHZ_CLIENT_PORT=5432
DB_AUTHZ_CLIENT_USERNAME=root
DB_AUTHZ_CLIENT_PASSWORD=root123
DB_AUTHZ_CLIENT_DATABASE=authorization_management_client

# ============================================================
# DOMAIN CONFIGURATIONS
# ============================================================

# Identity Access Management
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_STATUS=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_STRATEGY=multi_db
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_MASTER_DB=iam_master
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_CLIENT_DB=iam_client
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_TENANT_ENABLED=true
DOMAIN_IDENTITY_ACCESS_MANAGEMENT_TENANT_HEADER=x-tenant-id

# Authorization Management
DOMAIN_AUTHORIZATION_MANAGEMENT_STATUS=true
DOMAIN_AUTHORIZATION_MANAGEMENT_STRATEGY=multi_db
DOMAIN_AUTHORIZATION_MANAGEMENT_MASTER_DB=authz_master
DOMAIN_AUTHORIZATION_MANAGEMENT_CLIENT_DB=authz_client
DOMAIN_AUTHORIZATION_MANAGEMENT_TENANT_ENABLED=true
DOMAIN_AUTHORIZATION_MANAGEMENT_TENANT_HEADER=x-tenant-id

# ============================================================
# POOL CONFIGURATION
# ============================================================

PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=5000